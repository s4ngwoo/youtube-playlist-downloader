{
  "name": "youtube-playlist-downloader",
  "private": true,
  "version": "0.4.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "author": "Lee SangWoo <s4ngwoo.lee@gmail.com> (https://github.com/s4ngwoo)",
  "homepage": "https://github.com/s4ngwoo/youtube-playlist-downloader",
  "repository": {
    "type": "git",
    "url": "https://github.com/s4ngwoo/youtube-playlist-downloader.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" eslint.config.js vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" eslint.config.js vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "prepare:ffmpeg": "bash scripts/prepare-ffmpeg-sidecar.sh",
    "package:local-dmg": "npm run tauri -- build && node scripts/copy-local-dmg.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.4",
    "lucide-react": "^1.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
