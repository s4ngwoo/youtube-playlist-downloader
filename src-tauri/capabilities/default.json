{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-set-size-constraints",
    "opener:default",
    "shell:default",
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/yt-dlp",
          "sidecar": true,
          "args": true
        },
        {
          "name": "yt-dlp",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "bin/yt-dlp",
          "sidecar": true,
          "args": true
        },
        {
          "name": "yt-dlp",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "dialog:default"
  ]
}