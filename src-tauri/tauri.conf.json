{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Youtube Playlist Downloader",
  "version": "0.1.0",
  "identifier": "com.s4ngwoo.youtube-playlist-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Youtube Playlist Downloader",
        "width": 960,
        "height": 860,
        "minWidth": 720,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http: ipc:; font-src 'self' https: data:; img-src 'self' asset: https://asset.localhost https: http: data: blob:; media-src 'self' asset: https://asset.localhost https: http: blob: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/yt-dlp"
    ]
  }
}
